{
  "name": "sheetcord",
  "version": "0.2.60",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --configLoader native --host 127.0.0.1",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:watch": "node scripts/test.mjs --watch",
    "check": "node node_modules/typescript/bin/tsc --noEmit && node scripts/test.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "fflate": "0.8.2",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "emoji-regex": "10.5.0"
  }
}
